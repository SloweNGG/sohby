# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
.open-next
.wrangler
.dev.vars*
!.dev.vars.example

# yerel test çıktıları
/test-results
/playwright-report

# yerel görsel kontrol sayfaları (commit edilmez)
/src/app/[[]locale]/dev-preview/

# supabase cli yerel durumu
supabase/.temp/
supabase/.branches/

# yönetim paneli
/admin/node_modules
/admin/.next/
/admin/.open-next
/admin/.wrangler
/admin/.env*
!/admin/.env.example
/admin/next-env.d.ts
/admin/*.tsbuildinfo

# Uçtan uca test çıktıları (ekran görüntüleri, izler, test hesapları)
/e2e-sonuclar/
/playwright-report/
/test-results/
