# Supabase projesinin adresi, örn. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase "publishable" anahtarı (sb_publishable_...). Gizli (secret) anahtar KOYMAYIN.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sitenin kök adresi (e-posta doğrulama ve şifre sıfırlama bağlantıları için),
# örn. https://sohby.com — boşsa istek başlığından türetilir.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile site anahtarı (herkese açık). Gizli anahtar BURAYA DEĞİL,
# Supabase paneline (Authentication → Bot and Abuse Protection) girilir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry DSN (herkese açık). Boşsa Sentry çalışmaz.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
