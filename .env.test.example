# Uçtan uca testlerin (npm run test:e2e) bağlandığı AYRI test Supabase projesi.
# Bu dosyayı .env.test.local adıyla kopyalayıp test projesinin değerlerini yaz.
# Gerçek projenin (sohbymain) değerlerini KOYMA: testler o durumda başlamaz.
# Test projesinin adresi, örn. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Test projesinin "publishable" anahtarı (sb_publishable_...). Gizli (secret) anahtar KOYMA.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
